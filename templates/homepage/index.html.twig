{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block javascripts %}
	{% block importmap %}
		{{ importmap(['app']) }}
	{% endblock %}
{% endblock %}

{% block body %}
	<body
		class="bg-gray-100">
		<!-- Header -->
		<header class="bg-blue-900 text-white py-4">
			<div class="container mx-auto flex justify-between items-center">
				<div class="text-2xl font-bold">Endie-pro</div>
				<nav class="space-x-4">
					<a href="#" class="text-white hover:text-gray-300">Accueil</a>
					<a href="#" class="text-white hover:text-gray-300">Nos Services</a>
					<a href="#" class="text-white hover:text-gray-300">Galeries</a>
					<a href="#" class="text-white hover:text-gray-300">Contact</a>
					<a href="#" class="text-white hover:text-gray-300">FAQ</a>
					<a href="#" class="text-white hover:text-gray-300">À propos</a>
				</nav>
			</div>
		</header>

		<!-- Main Content -->
		<main class="py-10">
			<div
				class="container mx-auto">
				<!-- Section 1 -->
				<div class="text-center mb-10">
					<h1 class="text-4xl font-bold mb-4">Endie-pro</h1>
					<p class="text-gray-700">Je suis photographe et vidéaste de mariage...</p>
				</div>

				<!-- Images and Text -->
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- Left Image -->
					<div>
						<img src="/path/to/image1.jpg" alt="Bride" class="rounded shadow-md">
					</div>
					<!-- Right Text -->
					<div>
						<p class="text-gray-700">
							J'exerce la profession de photographe et vidéaste de mariage et de photos d'entreprise...
						</p>
					</div>
				</div>

				<!-- Additional Sections -->
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
					<!-- Text Block -->
					<div>
						<p class="text-gray-700">
							En effet, j’interviens dans les entreprises pour photographier...
						</p>
					</div>
					<!-- Image Block -->
					<div>
						<img src="/path/to/image2.jpg" alt="Group of Bridesmaids" class="rounded shadow-md">
					</div>
				</div>
			</div>
		</main>

		<!-- Footer -->
		<footer class="bg-blue-900 text-white py-4 mt-10">
			<div class="container mx-auto text-center">
				<p>© 2023 Endie_pro. Tous droits réservés.</p>
			</div>
		</footer>
	</body>
{% endblock %}

